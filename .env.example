# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=180.0

# Generation
DEFAULT_MODEL=VladimirGav/gemma4-26b-16GB-VRAM-Uncensored:latest
DEFAULT_TEMPERATURE=0.8
ENABLE_THINKING=true
USE_CHAT_API=true

# Memory
MAX_MEMORIES_PER_CHARACTER=20
RECENT_MEMORIES_FOR_PROMPT=10
MEMORY_RELEVANCE_TOP_K=5
ENABLE_RELEVANT_MEMORY_SELECTION=true
BM25_K1=1.5
BM25_B=0.75

# Summary
SUMMARY_INTERVAL_MESSAGES=20
SUMMARY_MAX_PARAGRAPHS=3

# Adaptive Consolidation (Plans/update20.md §20, Sprint 12)
# Score-based replacement for the 24h timer. Canary: off by default.
ADAPTIVE_CONSOLIDATION_ENABLED=false
# Score = messages*w1 + events*w2 + facts*w3 + rel_events*w4 + story_events*w5 + anchors*w7
CONSOLIDATION_WEIGHT_MESSAGES=1
CONSOLIDATION_WEIGHT_EVENTS=2
CONSOLIDATION_WEIGHT_FACTS=3
CONSOLIDATION_WEIGHT_REL_EVENTS=4
CONSOLIDATION_WEIGHT_STORY_EVENTS=5
CONSOLIDATION_WEIGHT_ANCHORS=7
CONSOLIDATION_SOFT_THRESHOLD=25
CONSOLIDATION_HARD_THRESHOLD=50
CONSOLIDATION_CRITICAL_IMPORTANCE=8
CONSOLIDATION_CRITICAL_MAX_PER_ROUND=2
CONSOLIDATION_POLL_SECONDS=600

# Witness
ENABLE_WITNESS_FILTER=true
WITNESS_MENTIONED_SNIPPET_LEN=120

# Repetition
REPETITION_DETECTION_ENABLED=true
REPETITION_WINDOW_SIZE=6
REPETITION_THRESHOLD=0.72

# Context Builder (token-aware context per character)
# CONTEXT_ENABLED=false switches back to the legacy fixed-length history trimming.
CONTEXT_ENABLED=true
# Total per-character context budget in tokens. Real prompts rarely exceed
# ~55K chars (~14-18K tokens), so 16000 keeps the KV window small while the
# recent-dialogue component still gets the bulk (see budgets below).
MAX_CONTEXT_TOKENS=16000
# Soft per-component budgets (tokens). Balanced for MAX_CONTEXT_TOKENS=16000:
# recent dialogue is the flexible remainder (P1) and must not be starved.
CONTEXT_RECENT_MIN_TOKENS=5000
CONTEXT_RECENT_MAX_TOKENS=9000
CONTEXT_MEMORY_BUDGET=2000
CONTEXT_RETRIEVAL_BUDGET=1500
CONTEXT_SUMMARY_BUDGET=2000
CONTEXT_STATE_BUDGET=1500
CONTEXT_RESERVE_TOKENS=3000
# History window loaded for retrieval (safety cap, not a semantic boundary)
CONTEXT_HISTORY_LOAD_CAP=2000
# BM25 retrieval candidates considered by the builder
CONTEXT_RETRIEVAL_CANDIDATES=30
# Token counting: estimated (fast, default) or exact (requires tiktoken + TOKENIZER_ENCODING)
TOKEN_COUNT_MODE=estimated
TOKENIZER_ENCODING=
# Verbose context diagnostics in logs
CONTEXT_DEBUG=false

# Dynamic Ollama num_ctx (KV window). ContextBudgetManager считает окно на
# каждый запрос: prompt + история + ответ + thinking-резерв + safety margin,
# clamp в [MIN_CTX, MAX_CTX] и round вверх до шагов (KV cache reuse).
# MIN_CTX — нижний порог окна (не «фиксированный» контекст): короткие чаты
# держат маленький KV cache => быстрее ответы и меньше VRAM.
MIN_CTX=8192
MAX_CTX=32778
# Максимальный размер ответа, включаемый в расчёт окна (max_new_tokens).
RESPONSE_BUDGET_TOKENS=2000
# Thinking Mode резервирует запас под reasoning (всегда при thinking).
THINKING_RESERVE=2048
# Safety margin: max(SAFETY_MARGIN, 10% от prompt) запасных токенов.
SAFETY_MARGIN=1000
# Округлять num_ctx вверх до шагов CONTEXT_ROUND_STEPS (переиспользование KV cache).
ROUND_CONTEXT=true
CONTEXT_ROUND_STEPS=4096,6144,8192,10240,12288,16384,20480,24576,28672,32768,40960,49152,65536

# Rate limit
RATE_LIMIT_SECONDS=5

# Character avatars (Этап A/B плана profile-avatar-appearance)
AVATAR_DIR=app/static/avatars
AVATAR_MAX_SIZE_MB=5
AVATAR_MAX_DIMENSION=512
# Допустимые форматы фиксированы в коде: png, jpeg, webp

# Sensors Model (Plans/update20.md §5.1) — отдельный аналитический слой для
# фоновых задач (perception/event/emotion/memory/relationship-предложения).
# Пусто = Sensors выключен (legacy-поведение). НЕ влияет на DEFAULT_MODEL и
# генерацию реплик персонажей. Sprint 0: только инфраструктура, без подключения.
SENSORS_MODEL=satgeze/gemma4-12b-uncensored-1.5m:latest
SENSORS_ENABLED=false
SENSORS_PERCEPTION_ENABLED=false
SENSORS_EVENT_ENABLED=false
SENSORS_EMOTION_ENABLED=false
SENSORS_MEMORY_ENABLED=false
SENSORS_RELATIONSHIP_ENABLED=false
SENSORS_TIMEOUT=60.0
# num_ctx / num_predict на каждую sensor-задачу (только как default; меньше
# num_ctx — быстрее вызов, num_predict ограничивает ответ коротким JSON).
SENSORS_EMOTION_NUM_CTX=8000
SENSORS_EMOTION_NUM_PREDICT=512
SENSORS_PERCEPTION_NUM_CTX=16000
SENSORS_PERCEPTION_NUM_PREDICT=1024
SENSORS_MEMORY_NUM_CTX=16000
SENSORS_MEMORY_NUM_PREDICT=1024
SENSORS_RELATIONSHIP_NUM_CTX=16000
SENSORS_RELATIONSHIP_NUM_PREDICT=1024
SENSORS_SCENE_STATE_NUM_CTX=8000
SENSORS_SCENE_STATE_NUM_PREDICT=1024

# Memory Architecture v2 (Plans/update20.md §7, Sprint 2) — типы памяти
# (semantic/episodic/social/story) + эмоциональные якоря (memory_anchors).
# По умолчанию выключены: колонки пишутся/читаются только при MEMORY_TYPES_ENABLED=true.
MEMORY_TYPES_ENABLED=false
ANCHORS_ENABLED=false
RELATIONSHIP_ANCHOR_MAX=3

# Relationship Evolution v2 (Plans/update20.md §18/§10/§7, Sprint 7)
# Dynamic decay: jealousy/resentment затухают со скоростью base_rate × character_factor,
# где factor выводится из character_state.stress (высокий стресс → медленнее затухание).
# По умолчанию выключен — legacy-скорости (jealousy 3, resentment 1) без изменений.
DYNAMIC_DECAY_ENABLED=false
DYNAMIC_DECAY_JEALOUSY_BASE_RATE=3
DYNAMIC_DECAY_RESENTMENT_BASE_RATE=1
DYNAMIC_DECAY_STRESS_SENSITIVITY=0.5
DYNAMIC_DECAY_FACTOR_MIN=0.4
DYNAMIC_DECAY_FACTOR_MAX=1.6
# Reciprocity pipeline: сильное убеждение (belief) source о target сужает кап дельты
# (множитель clamp(1 - dampening·max_confidence, min, 1)). По умолчанию выключен.
RECIPROCITY_ENABLED=false
RECIPROCITY_BELIEF_DAMPENING=0.5
RECIPROCITY_BELIEF_MULTIPLIER_MIN=0.5

# Character State (Plans/update20.md §8, Sprint 3) — единое runtime-состояние
# персонажа (эмоции/стресс/mood/физика/внимание/цели) в character_states.
# Пост-раунд детерминированно обновляется emotion_engine'ом из relationship
# deltas + событий раунда; блок YOUR STATE рендерится только при включённом флаге.
# Выключен = таблица не пишется/не читается (legacy-поведение).
CHARACTER_STATE_ENABLED=false
# Caps emotion_engine: сколько интенсивности эмоции может добавиться за раунд,
# сколько стресса (0..1).
EMOTION_ROUND_CAP=0.4
STRESS_ROUND_CAP=0.2
# Sensors-предложение эмоции может сдвинуть интенсивность не более чем на этот
# порог за раунд (Sensors НЕ задаёт mood напрямую).
SENSORS_EMOTION_INTENSITY_CAP=0.3
# ---- Attention (Plans/update20.md §11, Sprint 4) ----
# «Воспринято ≠ вошло в сознание». Детерминированный attention score пары
# (персонаж, событие) пишется в message_presence.attention и фильтрует только
# то, что идёт в память/recency tail. НЕ меняет presence-лестницу/render.
# Выключен = attention не считается (NULL в БД, legacy-поведение).
ATTENTION_ENABLED=false
# Пороги: < LOW — «слышал фоном» (не в память/реакцию);
# LOW <= score < HIGH — «заметил»; >= HIGH — «в центре внимания».
ATTENTION_LOW=0.35
ATTENTION_HIGH=0.7
# Веса компонентов score (сумма нормируется на 1.0).
ATTENTION_WEIGHT_VOLUME=0.15
ATTENTION_WEIGHT_DISTANCE=0.15
ATTENTION_WEIGHT_RELEVANCE=0.10
ATTENTION_WEIGHT_PERSONAL=0.25
ATTENTION_WEIGHT_EMOTIONAL=0.10
ATTENTION_WEIGHT_NOVELTY=0.05
ATTENTION_WEIGHT_RELATIONSHIP=0.05
ATTENTION_WEIGHT_ADDRESS=0.15
# Sensors perception-proposal (§5.1.3): significance (0..1) может поднять
# attention score не более чем на этот порог (Sensors не решает доступность).
SENSORS_PERCEPTION_SIGNIFICANCE_CAP=0.15

# ---- Hybrid Retrieval v2 (Plans/update20.md §14, Sprint 6) ----
# Детерминированный rerank memories ПОСЛЕ RRF, ДО witness-boost: ось
# memory_type/valence/intensity + сигналы контекста (отношения, story_threads).
# Выключен = RRF-путь без изменений; BM25 не удаляется (fallback без embeddings).
HYBRID_RERANK_ENABLED=false
# Веса осей (сумма нормируется на 1.0; без embeddings semantic отпадает).
HYBRID_RERANK_WEIGHT_LEXICAL=0.30
HYBRID_RERANK_WEIGHT_SEMANTIC=0.25
HYBRID_RERANK_WEIGHT_EMOTIONAL=0.10
HYBRID_RERANK_WEIGHT_STORY=0.15
HYBRID_RERANK_WEIGHT_RELATIONSHIP=0.10
HYBRID_RERANK_WEIGHT_RECENCY=0.05
HYBRID_RERANK_WEIGHT_SALIENCE=0.05

# Crisis Engine (Plans/update20.md §19, Sprint 11) — мягкое обнаружение кризисов.
# Детерминированный story pressure (base/trajectory/beliefs) → кандидат (правила)
# → resolution (мягко: story_event + story_thread «Кризис» + boost proactive).
# Запрещён паттерн `if trust<30: force_argument`: кризис — вероятность, не команда.
# Выключен = кризис не рендерится/не пишется (legacy-поведение).
CRISIS_ENGINE_ENABLED=false
# LLM-оценка типа кризиса (JSON-schema, мягко) — ТОЛЬКО после прохождения
# `benchmark_structured` на crisis-evaluation (benchmark gate §27); иначе —
# детерминированный pressure + type из правил, без LLM.
CRISIS_EVALUATION_ENABLED=false
CRISIS_PRESSURE_THRESHOLD=0.5
# Open issue без упоминания ≥ N раундов — сигнал неразрешённости конфликта.
CRISIS_MIN_ISSUE_AGE_ROUNDS=4
# Веса компонентов crisis pressure (§19), сумма нормируется.
CRISIS_WEIGHT_BASE=0.5
CRISIS_WEIGHT_TRAJECTORY=0.3
CRISIS_WEIGHT_BELIEFS=0.2
# Мягкий proactive boost вовлечённым в кризис персонажам (cap).
CRISIS_BOOST_CAP=0.3
CRISIS_EVENT_IMPORTANCE=7.0
CRISIS_THREAD_PREFIX=Кризис

# World & Perception Engine 3.0 (Plans/WPE.md) — флаги фаз WPE.
# По умолчанию выключены (Фаза 0 — фундамент без изменения поведения).
# Включаются по одной, в порядке фаз 1→7, отдельным canary'ем; откат — выключение флага.

# Фаза 1 — Канонические локации (read-path): сравнение «одна локация» по
# location_id. Требует backfill location_id (scripts/backfill_location_ids.py);
# при отсутствии id с одной стороны — legacy-bridge (сравнение строк).
WORLD_ENGINE_LOCATIONS_ENABLED=false

# Фаза 2 — Tool-calling take_actions (shadow): действия извлекаются в TurnOutput,
# логируются, НЕ применяются. Единственный источник turn.actions. При недоступных
# tools/format генерация падает (RuntimeError, И14) — проверить поддержку модели.
WORLD_ENGINE_TOOLS_ENABLED=false

# Фаза 3 — WorldEvent dual-write атомарно с Message + shadow perceive() 2 канала
# (классификация расхождений, [WPE-P3]).
WORLD_ENGINE_EVENTS_ENABLED=false

# Фаза 4 — Cutover: presence пишется через двухканальный perceive() + Renderer.
WORLD_ENGINE_PERCEPTION_ENABLED=false

# Фаза 4 — Recency Tail: P0-события (addressed/delivered) в самый конец промпта
# перед generation cue, защищён от усечения бюджетом.
WORLD_ENGINE_RECENCY_TAIL_ENABLED=false

# Фаза 5 — Action Resolution: применение действий + System Narrator + Consistency
# Validator. Требует WORLD_ENGINE_TOOLS_ENABLED (иначе turn.actions не извлекаются).
WORLD_ENGINE_ACTIONS_ENABLED=false
# Тюнинг (Фаза 5): бюджет contradiction-ретраев внутри generate().
WORLD_ENGINE_CONSISTENCY_MAX_RETRIES=1

# Фаза 6 — Threads/мессенджер: Thread + ThreadParticipantState для удалённых
# каналов (magic/phone/radio/messenger); адресат получает delivered независимо
# от локации (Golden #6/#15).
WORLD_ENGINE_THREADS_ENABLED=false
# Фаза 6 — Частичное восприятие по каналам: проницаемость рёбер, громкость,
# невидимость, voice familiarity. Рендер требует также PERCEPTION_ENABLED.
WORLD_ENGINE_PARTIAL_PERCEPTION_ENABLED=false

# Фаза 7 — Event Bus / Interrupts: очередь приоритетов генерации, буждение NPC
# по addressed=true. При off — run_round_fixed (исходный фиксированный порядок).
WORLD_ENGINE_EVENT_BUS_ENABLED=false
